# ===== Cashflow Beyond — fill these in, then `docker compose up --build` =====

# 1) Firebase (Authentication only) — from your Firebase project > Web App config.
#    Steps: Firebase Console > Project Settings > Your apps > Web app > SDK config (Config radio).
#    Also enable the Google sign-in provider:
#      Firebase Console > Authentication > Sign-in method > Google > Enable.
#    Add authorized domains (required for Google login to work):
#      Firebase Console > Authentication > Settings > Authorized domains
#      Add: localhost  AND  your tunnel hostname (e.g. cashflow.yourdomain.com).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-side Firebase token verification (same project id as above):
FIREBASE_PROJECT_ID=

# 2) MongoDB (production = local shared-mongo via the shared-db Docker network).
#    Use the dedicated cashflow_app user created during setup (see README):
MONGO_URL=mongodb://cashflow_app:CHANGE_ME@shared-mongo:27017/cashflow?authSource=cashflow
# TEST db (remote, do not use for production):
# MONGO_URL=mongodb://cashflow_app:CHANGE_ME@203.113.14.27:27017/cashflow?authSource=cashflow

# 3) Cloudflare Tunnel — this repo uses a LOCALLY-MANAGED tunnel (no token needed):
#    ingress is in cloudflared/config.yml and the secret is cloudflared/credentials.json (gitignored).
#    The tunnel 'cashflow-beyond' -> cashflow.jeerawut.com is already created. To recreate elsewhere:
#      cloudflared tunnel create <name> && cloudflared tunnel route dns <name> <hostname>
#      then put the <uuid>.json at cloudflared/credentials.json and set the hostname in cloudflared/config.yml.
